{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "Переводы и подписи класса (data/<класс>/manual/labels.json)",
  "description": "Список переводов (первый — базовый) и тексты узлов, которых нет на сайтах: корень, группы, темы.",
  "type": "object",
  "required": ["langs", "texts"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "langs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "title", "source", "terms"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
          "label": { "type": "string", "description": "подпись кнопки переключателя" },
          "title": { "type": "string" },
          "source": { "type": "string", "description": "откуда тексты (в подвале)" },
          "terms": {
            "type": "object",
            "required": ["feat", "feats", "Feat", "Feats", "prereq"],
            "additionalProperties": false,
            "properties": {
              "feat": { "type": "string" },
              "feats": { "type": "string" },
              "Feat": { "type": "string" },
              "Feats": { "type": "string" },
              "prereq": { "type": "string" }
            }
          }
        }
      }
    },
    "pendingLangs": {
      "type": "array",
      "description": "локализации, текстов которых пока нет: кнопка в переключателе есть, по нажатию — сообщение",
      "items": {
        "type": "object",
        "required": ["id", "label", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
          "label": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "texts": {
      "type": "object",
      "description": "тексты по переводу и id узла",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/definitions/text" }
      }
    },
    "notes": { "type": "object", "description": "пометки к узлам, текста которых нет в переводе (показан оригинал AoN)", "additionalProperties": { "type": "string" } }
  },
  "definitions": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "short": { "type": "string" },
        "html": { "type": "string" },
        "hint": { "type": "string" },
        "url": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
